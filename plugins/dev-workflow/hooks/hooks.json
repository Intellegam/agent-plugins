{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject-workflow.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(general-purpose|claude)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject-workflow.sh"
          }
        ]
      }
    ]
  }
}
